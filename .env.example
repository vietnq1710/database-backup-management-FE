# ── Backend NestJS ─────────────────────────────────────────────
VITE_API_URL=             # URL của BE NestJS, dùng làm proxy target khi dev (mặc định http://localhost:3000)

# ── Keycloak SSO ───────────────────────────────────────────────
VITE_KEYCLOAK_URL=        # vd: http://localhost:8080
VITE_KEYCLOAK_REALM=      # tên realm, vd: master
VITE_KEYCLOAK_CLIENT_ID=  # client dạng public (Standard Flow + PKCE)
